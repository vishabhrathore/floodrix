// ─── NODE F: PMP Chain (24 hr) ─────────────────────────────────────────────────
// Excel chain:
//   I2 = E8/10                       (SPS 1 day = weighted_mm / 10)        cm
//   I5 = ARF                         (point-to-areal interp on area)
//   I6 = I2 × I3 × I5                (SPS 24 hr = SPS_1day × CHC × ARF)    cm
//   I7 = I6 × I4                     (PMP 24 hr = SPS × MMF)               cm

export const nodePMPChain24hr: CalcNode = {
  id: "node-pmp-24hr",
  type: CalcNodeType.MULTI_FORMULA,
  label: "PMP 24-hour Chain",
  description: "SPS → CHC × ARF → MMF",
  sortOrder: 6,
  config: {
    expressions: [
            { outputKey: "sps_24hr_cm", expression: "sps_1day_cm * clock_hour_corr * areal_reduction", unit: "cm", description: "SPS 24 hr = SPS_1day × CHC × ARF"
            },
            { outputKey: "pmp_24hr_cm", expression: "sps_24hr_cm * mmf",                                unit: "cm", description: "PMP 24 hr = SPS × MMF"
            },
        ],
    },
  markdownTemplate: `## 💧 PMP — 24-hour Storm

| Step                                            | Value             |
|-------------------------------------------------|-------------------|
| SPS 1-day (weighted mean)                       | {
        {sps_1day_cm
        }
    } cm |
| × Clock-Hour Correction                         | × {
        {clock_hour_corr
        }
    } |
| × Areal Reduction Factor (A = {
        {catchment_area
        }
    } km²) | × {
        {areal_reduction
        }
    } |
| **SPS 24-hr**                                   | **{
        {sps_24hr_cm
        }
    } cm** |
| × Moisture Maximization Factor                  | × {
        {mmf
        }
    }         |
| **PMP 24-hr**                                   | **{
        {pmp_24hr_cm
        }
    } cm** |
`,
};


