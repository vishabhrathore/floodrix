// ─── NODE I: Rainfall Excess + Critical Sequencing + Convolution → DRH ─────────
// Replaces the inline 24hr/48hr PMF code in MEMORY.md §12 with a single
// generic node that works for any duration. Caller passes bell depths.

export const nodeCriticalConvolve: CalcNode = {
  id: "node-pmf-build",
  type: CalcNodeType.CUSTOM_CODE,
  label: "Critical Sequencing & Convolution → PMF",
  description: "Apply loss → critical (LARGE-by-rank) sequencing → convolve each 12-hr bell with UH → add base flow",
  sortOrder: 9,
  config: {
    inputKeys: [
            "uh_ordinates",
            "catchment_area",
            "loss_rate",
            "base_flow",
            "bell_distribution_pct",
            "bell1_24hr_cm",
            "bell2_24hr_cm"
        ],
    outputKeys: [
            "pmf_24hr",
            "pmf_24hr_peak",
            "rainfall_excess_24hr"
        ],
    code: `
      const uh    = inputs.uh_ordinates;
      const A     = inputs.catchment_area;
      const phi   = inputs.loss_rate;
      const Qb    = inputs.base_flow * A;
      const cumPct= inputs.bell_distribution_pct; // [15.1, 25.5, ..., 73.0]
      const bells = [inputs.bell1_24hr_cm, inputs.bell2_24hr_cm
        ];

      // Cumulative % → incremental % per hour
      const incr = cumPct.map((v,i) => i===0 ? v : v - cumPct[i-1
        ]);
      // Normalize so increments sum to 100 (Excel's bell-coeff convention)
      const total = incr.reduce((s,v)=>s+v,
        0);
      const normIncr = incr.map(v => v * (100/total));

      // Build hourly rainfall, apply loss φ (cm/hr) → excess, then sort desc
        // (Excel:  =LARGE($..,_xlfn.RANK.AVG(...))  re-arranges to peak-critical)
      function buildExcess(depthCm) {
        const hourly = normIncr.map(p => (p/100) * depthCm); // cm/hr
        const excess = hourly.map(r => Math.max(0, r - phi));
        return [...excess
            ].sort((a,b) => b - a); // LARGE descending
        }
        // Convolution: discrete sum, dt = 1 hr
      function conv(uh, rain) {
        const out = new Array(uh.length + rain.length - 1).fill(0);
        for (let i = 0; i < rain.length; i++)
          for (let j = 0; j < uh.length; j++)
            out[i+j
            ] += rain[i
            ] * uh[j
            ];
        return out;
        }
        // Each bell's DRH starts 12 hr after the previous
      const drhs = bells.map((d, bi) => ({ drh: conv(uh, buildExcess(d)), offset: bi * 12
        }));
      const totalLen = Math.max(...drhs.map(d => d.drh.length + d.offset));
      const combined = new Array(totalLen).fill(0);
      drhs.forEach(({ drh, offset
        }) => drh.forEach((v,i) => { combined[i + offset
            ] += v;
        }));

      const pmf  = combined.map(v => v + Qb);
      const peak = Math.max(...pmf);
      const excessAll = bells.flatMap(buildExcess);

      return {
        pmf_24hr: pmf,
        pmf_24hr_peak: peak,
        rainfall_excess_24hr: excessAll,
        };
    `,
    },
};


