// ─── NODE D: Weighted Rainfall from Isohyetal Bands ────────────────────────────
// 24hr SPS sheet rows 5..7: Weighted = Σ(area × mean_iso) / total_area

export const nodeWeightedRainfall: CalcNode = {
  id: "node-weighted-rainfall",
  type: CalcNodeType.CUSTOM_CODE,
  label: "Weighted Mean Rainfall (Isohyetal)",
  description: "Σ(Aᵢ × Pᵢ_mean) / ΣAᵢ across isohyetal bands",
  sortOrder: 4,
  config: {
    inputKeys: [
            "isohyet_bands"
        ],
    outputKeys: [
            "weighted_rainfall_mm",
            "sps_1day_cm"
        ],
    code: `
      const bands = inputs.isohyet_bands || [];
      let sumAreaP = 0, sumArea = 0;
      const rows = [];
      for (const b of bands) {
        const meanP = (b.iso_min_mm + b.iso_max_mm) / 2;
        const weighted = b.area_sqkm * meanP;
        sumAreaP += weighted;
        sumArea  += b.area_sqkm;
        rows.push({ ...b, mean: meanP, weighted
            });
        }
      const weighted_mm = sumArea > 0 ? (sumAreaP / sumArea) : 0;
      return {
        weighted_rainfall_mm: weighted_mm,
        sps_1day_cm: weighted_mm / 10, // mm → cm  (Excel: I2 = E8/10)
        };
    `,
    },
  markdownTemplate: `## 🌧️ Weighted Rainfall (Isohyetal Bands)

- **ΣArea·P̄ / ΣArea = {
        {weighted_rainfall_mm
        }
    } mm**
- **SPS 1-day = {
        {sps_1day_cm
        }
    } cm**
`,
};


