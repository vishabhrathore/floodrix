{
    "version": "1.0",
    "domain": "Hydrology \u2014 SUH / PMP / PMF",
    "source_workbook": "SUH_S1_19082025.xlsm",
    "notes": "Seed each `formulas` entry as a row keyed by `id`. `expression` is a mathjs string. `inputs` are the named variables it reads; `output` is the named variable it writes. Lookup tables live in `tables`. Helper functions used: pow, max, sum, lerp, interp1d, trapzXY, convolve, arrScale, arrAdd, roundTo.",
    "formulas": [
        {
            "id": "equiv-slope",
            "category": "Catchment",
            "name": "Equivalent Stream Slope",
            "expression": "sum_li_di_prev_di / pow(stream_length, 2)",
            "math_form": "S = \u03a3 L\u1d62 \u00b7 (D\u1d62\u208b\u2081 + D\u1d62) / L\u00b2",
            "inputs": [
                {
                    "key": "sum_li_di_prev_di",
                    "label": "\u03a3 L\u1d62(D\u1d62\u208b\u2081+D\u1d62)",
                    "unit": "km\u00b7m"
                },
                {
                    "key": "stream_length",
                    "label": "Stream Length L",
                    "unit": "km"
                }
            ],
            "output": {
                "key": "equiv_slope",
                "label": "Equivalent Slope S",
                "unit": "m/km"
            },
            "source": "CWC SUH method, Table 1"
        },
        {
            "id": "suh-tp",
            "category": "SUH",
            "name": "Time to Peak",
            "expression": "a_tp * pow(qp, b_tp)",
            "math_form": "tp = a_tp \u00b7 qp^b_tp",
            "inputs": [
                {
                    "key": "a_tp",
                    "label": "tp linear coefficient"
                },
                {
                    "key": "b_tp",
                    "label": "tp power exponent"
                },
                {
                    "key": "qp",
                    "label": "Peak Unit Discharge qp",
                    "unit": "cumec/sqkm"
                }
            ],
            "output": {
                "key": "tp",
                "label": "Time to Peak",
                "unit": "hr"
            },
            "source": "CWC sub-zone regression"
        },
        {
            "id": "suh-qp",
            "category": "SUH",
            "name": "Peak Unit Discharge",
            "expression": "a_qp * pow(stream_length / equiv_slope, b_qp)",
            "math_form": "qp = a_qp \u00b7 (L/S)^b_qp",
            "inputs": [
                {
                    "key": "a_qp"
                },
                {
                    "key": "b_qp"
                },
                {
                    "key": "stream_length",
                    "unit": "km"
                },
                {
                    "key": "equiv_slope",
                    "unit": "m/km"
                }
            ],
            "output": {
                "key": "qp",
                "label": "Peak Unit Discharge",
                "unit": "cumec/sqkm"
            }
        },
        {
            "id": "suh-Qp",
            "category": "SUH",
            "name": "Peak Discharge",
            "expression": "qp * catchment_area",
            "math_form": "Qp = qp \u00b7 A",
            "inputs": [
                {
                    "key": "qp",
                    "unit": "cumec/sqkm"
                },
                {
                    "key": "catchment_area",
                    "unit": "sq.km"
                }
            ],
            "output": {
                "key": "Qp",
                "label": "Peak Discharge",
                "unit": "cumec"
            }
        },
        {
            "id": "suh-Tm",
            "category": "SUH",
            "name": "Time to Rise",
            "expression": "tp + tr / 2",
            "math_form": "Tm = tp + tr/2",
            "inputs": [
                {
                    "key": "tp",
                    "unit": "hr"
                },
                {
                    "key": "tr",
                    "label": "Unit rainfall duration",
                    "unit": "hr"
                }
            ],
            "output": {
                "key": "Tm",
                "label": "Time to Rise",
                "unit": "hr"
            }
        },
        {
            "id": "suh-W50",
            "category": "SUH",
            "name": "Width at 50% Qp",
            "expression": "a_W50 * pow(qp, b_W50)",
            "math_form": "W50 = a_W50 \u00b7 qp^b_W50",
            "inputs": [
                {
                    "key": "a_W50"
                },
                {
                    "key": "b_W50"
                },
                {
                    "key": "qp"
                }
            ],
            "output": {
                "key": "W50",
                "unit": "hr"
            }
        },
        {
            "id": "suh-W75",
            "category": "SUH",
            "name": "Width at 75% Qp",
            "expression": "a_W75 * pow(qp, b_W75)",
            "math_form": "W75 = a_W75 \u00b7 qp^b_W75",
            "inputs": [
                {
                    "key": "a_W75"
                },
                {
                    "key": "b_W75"
                },
                {
                    "key": "qp"
                }
            ],
            "output": {
                "key": "W75",
                "unit": "hr"
            }
        },
        {
            "id": "suh-WR50",
            "category": "SUH",
            "name": "Rising Limb Width at 50%",
            "expression": "a_WR50 * pow(qp, b_WR50)",
            "math_form": "WR50 = a_WR50 \u00b7 qp^b_WR50",
            "inputs": [
                {
                    "key": "a_WR50"
                },
                {
                    "key": "b_WR50"
                },
                {
                    "key": "qp"
                }
            ],
            "output": {
                "key": "WR50",
                "unit": "hr"
            }
        },
        {
            "id": "suh-WR75",
            "category": "SUH",
            "name": "Rising Limb Width at 75%",
            "expression": "a_WR75 * pow(qp, b_WR75)",
            "math_form": "WR75 = a_WR75 \u00b7 qp^b_WR75",
            "inputs": [
                {
                    "key": "a_WR75"
                },
                {
                    "key": "b_WR75"
                },
                {
                    "key": "qp"
                }
            ],
            "output": {
                "key": "WR75",
                "unit": "hr"
            }
        },
        {
            "id": "suh-TB",
            "category": "SUH",
            "name": "Base Width",
            "expression": "a_TB * pow(tp, b_TB)",
            "math_form": "TB = a_TB \u00b7 tp^b_TB",
            "inputs": [
                {
                    "key": "a_TB"
                },
                {
                    "key": "b_TB"
                },
                {
                    "key": "tp"
                }
            ],
            "output": {
                "key": "TB",
                "unit": "hr"
            }
        },
        {
            "id": "weighted-mean-rainfall",
            "category": "Rainfall",
            "name": "Weighted Mean Rainfall (Isohyetal)",
            "expression": "sum_area_x_mean / sum_area",
            "math_form": "P\u0304 = \u03a3(A\u1d62 \u00b7 mean\u1d62) / \u03a3A\u1d62",
            "inputs": [
                {
                    "key": "sum_area_x_mean",
                    "label": "\u03a3 Area \u00d7 Mean P"
                },
                {
                    "key": "sum_area",
                    "label": "\u03a3 Area",
                    "unit": "sq.km"
                }
            ],
            "output": {
                "key": "weighted_rainfall_mm",
                "unit": "mm"
            },
            "source": "24hr SPS sheet E5:E8"
        },
        {
            "id": "isohyetal-band-mean",
            "category": "Rainfall",
            "name": "Isohyetal Band Mean Rainfall",
            "expression": "(iso_min_mm + iso_max_mm) / 2",
            "math_form": "mean\u1d62 = (P_min + P_max) / 2",
            "inputs": [
                {
                    "key": "iso_min_mm",
                    "unit": "mm"
                },
                {
                    "key": "iso_max_mm",
                    "unit": "mm"
                }
            ],
            "output": {
                "key": "iso_band_mean_mm",
                "unit": "mm"
            }
        },
        {
            "id": "mm-to-cm",
            "category": "UnitConversion",
            "name": "mm \u2192 cm",
            "expression": "depth_mm / 10",
            "math_form": "P_cm = P_mm / 10",
            "inputs": [
                {
                    "key": "depth_mm",
                    "unit": "mm"
                }
            ],
            "output": {
                "key": "depth_cm",
                "unit": "cm"
            }
        },
        {
            "id": "cm-to-mm",
            "category": "UnitConversion",
            "name": "cm \u2192 mm",
            "expression": "depth_cm * 10",
            "math_form": "P_mm = P_cm \u00b7 10",
            "inputs": [
                {
                    "key": "depth_cm",
                    "unit": "cm"
                }
            ],
            "output": {
                "key": "depth_mm",
                "unit": "mm"
            }
        },
        {
            "id": "sps-corrected",
            "category": "PMP",
            "name": "SPS with Corrections",
            "expression": "sps_point_cm * clock_hour_corr * areal_reduction",
            "math_form": "SPS_dur = SPS_point \u00b7 CHC \u00b7 ARF",
            "inputs": [
                {
                    "key": "sps_point_cm",
                    "label": "Point SPS",
                    "unit": "cm"
                },
                {
                    "key": "clock_hour_corr",
                    "label": "Clock-Hour Correction"
                },
                {
                    "key": "areal_reduction",
                    "label": "Areal Reduction Factor"
                }
            ],
            "output": {
                "key": "sps_dur_cm",
                "label": "Storm-duration SPS",
                "unit": "cm"
            },
            "source": "24hr SPS I6 = I2\u00b7I3\u00b7I5"
        },
        {
            "id": "pmp-from-sps",
            "category": "PMP",
            "name": "PMP from SPS",
            "expression": "sps_dur_cm * mmf",
            "math_form": "PMP = SPS \u00b7 MMF",
            "inputs": [
                {
                    "key": "sps_dur_cm",
                    "unit": "cm"
                },
                {
                    "key": "mmf",
                    "label": "Moisture Maximization Factor"
                }
            ],
            "output": {
                "key": "pmp_cm",
                "label": "PMP Depth",
                "unit": "cm"
            },
            "source": "24hr SPS I7 = I6\u00b7I4"
        },
        {
            "id": "bell-depth",
            "category": "BellSplit",
            "name": "Bell Depth from PMP",
            "expression": "pmp_total_cm * bell_pct / 100",
            "math_form": "bell_n = PMP \u00b7 bell% / 100",
            "inputs": [
                {
                    "key": "pmp_total_cm",
                    "unit": "cm"
                },
                {
                    "key": "bell_pct",
                    "label": "Bell percentage (e.g. 73 for 1st bell)"
                }
            ],
            "output": {
                "key": "bell_depth_cm",
                "unit": "cm"
            },
            "source": "PMP 12hr Bell depth sheet I3 = E3\u00b7B27%"
        },
        {
            "id": "bell-residual",
            "category": "BellSplit",
            "name": "Bell Residual",
            "expression": "pmp_total_cm - bell_depth_cm",
            "math_form": "bell_remainder = PMP_total \u2212 bell_assigned",
            "inputs": [
                {
                    "key": "pmp_total_cm",
                    "unit": "cm"
                },
                {
                    "key": "bell_depth_cm",
                    "unit": "cm"
                }
            ],
            "output": {
                "key": "bell_remainder_cm",
                "unit": "cm"
            }
        },
        {
            "id": "excess-rainfall",
            "category": "Runoff",
            "name": "Hourly Rainfall Excess",
            "expression": "max(0, rainfall_cm_hr - loss_rate)",
            "math_form": "excess = max(0, P \u2212 \u03c6)",
            "inputs": [
                {
                    "key": "rainfall_cm_hr",
                    "label": "Hourly rainfall",
                    "unit": "cm/hr"
                },
                {
                    "key": "loss_rate",
                    "label": "Uniform loss \u03c6",
                    "unit": "cm/hr"
                }
            ],
            "output": {
                "key": "rainfall_excess",
                "unit": "cm/hr"
            },
            "source": "24/48/72hr SPS sheets \u2014 IF((P\u2212\u03c6)<0,0,P\u2212\u03c6)"
        },
        {
            "id": "hourly-from-cum-pct",
            "category": "Runoff",
            "name": "Hourly Increment from Cumulative %",
            "expression": "i == 0 ? cum_pct[0] : cum_pct[i] - cum_pct[i-1]",
            "math_form": "incr\u1d62 = cum\u1d62 \u2212 cum\u1d62\u208b\u2081  (incr\u2080 = cum\u2080)",
            "inputs": [
                {
                    "key": "cum_pct",
                    "label": "Cumulative % array (Sheet3)"
                },
                {
                    "key": "i",
                    "label": "Hour index"
                }
            ],
            "output": {
                "key": "hourly_pct",
                "label": "Hourly percentage"
            },
            "notes": "Loop this for i = 0..11 to build the 12-hr hyetograph distribution"
        },
        {
            "id": "hourly-depth-from-pct",
            "category": "Runoff",
            "name": "Hourly Depth from %",
            "expression": "hourly_pct / 100 * bell_depth_cm",
            "math_form": "P\u1d62 = (incr\u1d62/100) \u00b7 bell_depth",
            "inputs": [
                {
                    "key": "hourly_pct"
                },
                {
                    "key": "bell_depth_cm",
                    "unit": "cm"
                }
            ],
            "output": {
                "key": "hourly_rainfall_cm",
                "unit": "cm/hr"
            }
        },
        {
            "id": "trapezoidal-area",
            "category": "Hydrograph",
            "name": "Trapezoidal Strip Area",
            "expression": "(y1 + y0) / 2 * (x1 - x0)",
            "math_form": "A = ((y\u1d62 + y\u1d62\u208b\u2081)/2) \u00b7 (x\u1d62 \u2212 x\u1d62\u208b\u2081)",
            "inputs": [
                {
                    "key": "x0"
                },
                {
                    "key": "x1"
                },
                {
                    "key": "y0"
                },
                {
                    "key": "y1"
                }
            ],
            "output": {
                "key": "trap_area"
            },
            "source": "SUH sheet (Tables 3 & 4 \u2014 UH area check)"
        },
        {
            "id": "uh-volume-check-cm",
            "category": "Hydrograph",
            "name": "UH Volume \u2192 Depth (cm)",
            "expression": "trapzXY(uh_times, uh_ordinates) * 3600 / (catchment_area * 1e6) * 100",
            "math_form": "depth = \u222bQ dt \u00b7 3600 / (A \u00b7 10\u2076) \u00b7 100",
            "inputs": [
                {
                    "key": "uh_times",
                    "label": "UH time array",
                    "unit": "hr"
                },
                {
                    "key": "uh_ordinates",
                    "label": "UH discharge array",
                    "unit": "cumec"
                },
                {
                    "key": "catchment_area",
                    "unit": "sq.km"
                }
            ],
            "output": {
                "key": "uh_depth_cm",
                "label": "UH net volume as depth",
                "unit": "cm"
            },
            "notes": "Should \u2248 1 cm for a valid 1-cm unit hydrograph"
        },
        {
            "id": "base-flow-discharge",
            "category": "Hydrograph",
            "name": "Base Flow Discharge",
            "expression": "base_flow_unit * catchment_area",
            "math_form": "Qb = qb \u00b7 A",
            "inputs": [
                {
                    "key": "base_flow_unit",
                    "label": "Unit base flow",
                    "unit": "cumec/sqkm"
                },
                {
                    "key": "catchment_area",
                    "unit": "sq.km"
                }
            ],
            "output": {
                "key": "base_flow_total",
                "unit": "cumec"
            }
        },
        {
            "id": "pmf-from-drh",
            "category": "Hydrograph",
            "name": "PMF = DRH + Base Flow",
            "expression": "drh_ordinates + base_flow_total",
            "math_form": "PMF(t) = DRH(t) + Qb",
            "inputs": [
                {
                    "key": "drh_ordinates",
                    "label": "DRH array",
                    "unit": "cumec"
                },
                {
                    "key": "base_flow_total",
                    "unit": "cumec"
                }
            ],
            "output": {
                "key": "pmf_ordinates",
                "unit": "cumec"
            },
            "notes": "Vector: use arrAdd(drh, fill(len, Qb))"
        },
        {
            "id": "uh-convolution",
            "category": "Hydrograph",
            "name": "UH \u00d7 Rainfall Excess Convolution",
            "expression": "convolve(uh_ordinates, rainfall_excess, 1)",
            "math_form": "DRH[t] = \u03a3\u1d62 rain[i] \u00b7 UH[t\u2212i]",
            "inputs": [
                {
                    "key": "uh_ordinates",
                    "label": "UH array",
                    "unit": "cumec/cm"
                },
                {
                    "key": "rainfall_excess",
                    "label": "Rainfall excess array",
                    "unit": "cm/hr"
                }
            ],
            "output": {
                "key": "drh_ordinates",
                "unit": "cumec"
            },
            "notes": "Discrete linear convolution, dt = 1 hr"
        },
        {
            "id": "critical-sequencing-desc",
            "category": "Hydrograph",
            "name": "Critical Storm Sequencing (descending)",
            "expression": "sort(rainfall_excess, 'desc')",
            "math_form": "rain_sorted = LARGE(rain, k) for k = 1..n",
            "inputs": [
                {
                    "key": "rainfall_excess"
                }
            ],
            "output": {
                "key": "rainfall_excess_critical"
            },
            "source": "24/48/72hr SPS sheets \u2014 LARGE($..,RANK.AVG(...))",
            "notes": "Place largest excess hours where UH ordinates peak to maximize PMF"
        },
        {
            "id": "areal-reduction-interp",
            "category": "PMP",
            "name": "Areal Reduction Factor (interpolated)",
            "expression": "interp1d(arf_table_area, arf_table_factor, catchment_area)",
            "math_form": "ARF = piecewise-linear(area, factor) at A",
            "inputs": [
                {
                    "key": "arf_table_area",
                    "label": "ARF table \u2014 area column"
                },
                {
                    "key": "arf_table_factor",
                    "label": "ARF table \u2014 factor column"
                },
                {
                    "key": "catchment_area",
                    "unit": "sq.km"
                }
            ],
            "output": {
                "key": "areal_reduction"
            },
            "source": "FORECAST.LINEAR over Table 3-84"
        }
    ],
