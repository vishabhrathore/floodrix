  {
    "id": "node_cc_hyeto",
    "type": "CUSTOM_CODE",
    "label": "Hyetograph + Loss + Critical Sequencing",
    "config": {
      "code": "const cum = [15.1, 25.5, 31.6, 36.9, 42.2, 47.1, 51.8, 56.4, 60.8, 65.2, 69.3, 73.0];\nlet incr = cum.map((v, i) => i === 0 ? v : v - cum[i-1]);\nconst norm = 100 / incr.reduce((s,v) => s+v, 0);\nincr = incr.map(v => v * norm);\n\nfunction critical(depth) {\n  const hourly = incr.map(p => (p/100) * depth);\n  const excess = hourly.map(r => Math.max(0, r - inputs.loss_rate));\n  return [...excess].sort((a,b) => b - a);\n}\nreturn {\n  excess_bell1: critical(inputs.bell1_cm),\n  excess_bell2: critical(inputs.bell2_cm)\n};",
      "use_worker": true,
      "output_variables": [
        "excess_bell1",
        "excess_bell2"
      ]
    }
  }
