      "code": "// CWC sub-zone regression coefficients\nconst table = {\n  \"1b\": {a_tp:1.56, b_tp:-0.81, a_qp:1.85, b_qp:-0.48, a_TB:4.20, b_TB:0.87, a_W50:2.10, b_W50:-0.95, a_W75:1.30, b_W75:-0.80, a_WR50:0.75, b_WR50:-0.90, a_WR75:0.52, b_WR75:-0.78},\n  \"1c\": {a_tp:2.195, b_tp:-0.944, a_qp:1.331, b_qp:-0.492, a_TB:3.917, b_TB:0.99, a_W50:2.04, b_W50:-1.026, a_W75:1.25, b_W75:-0.864, a_WR50:0.739, b_WR50:-0.968, a_WR75:0.5, b_WR75:-0.813},\n  \"2a\": {a_tp:1.25, b_tp:-0.75, a_qp:1.95, b_qp:-0.52, a_TB:4.50, b_TB:0.82, a_W50:2.15, b_W50:-0.92, a_W75:1.35, b_W75:-0.78, a_WR50:0.78, b_WR50:-0.88, a_WR75:0.54, b_WR75:-0.76},\n  \"3a\": {a_tp:0.433, b_tp:0.704,  a_qp:1.161, b_qp:0.635,  a_TB:8.375, b_TB:0.512, a_W50:2.284, b_W50:1.000, a_W75:1.331, b_W75:0.991, a_WR50:0.827, b_WR50:1.023, a_WR75:0.561, b_WR75:1.037},\n  \"3b\": {a_tp:0.50, b_tp:0.68, a_qp:1.20, b_qp:0.61, a_TB:8.00, b_TB:0.55, a_W50:2.30, b_W50:0.98, a_W75:1.35, b_W75:0.97, a_WR50:0.85, b_WR50:1.00, a_WR75:0.58, b_WR75:1.01},\n  \"3c\": {a_tp:0.48, b_tp:0.72, a_qp:1.15, b_qp:0.65, a_TB:8.50, b_TB:0.50, a_W50:2.25, b_W50:1.02, a_W75:1.32, b_W75:1.00, a_WR50:0.80, b_WR50:1.04, a_WR75:0.55, b_WR75:1.05},\n  \"3d\": {a_tp:0.45, b_tp:0.71, a_qp:1.18, b_qp:0.63, a_TB:8.40, b_TB:0.52, a_W50:2.27, b_W50:1.01, a_W75:1.34, b_W75:0.98, a_WR50:0.83, b_WR50:1.03, a_WR75:0.57, b_WR75:1.03},\n  \"3e\": {a_tp:0.42, b_tp:0.73, a_qp:1.14, b_qp:0.66, a_TB:8.60, b_TB:0.49, a_W50:2.23, b_W50:1.03, a_W75:1.30, b_W75:1.01, a_WR50:0.79, b_WR50:1.05, a_WR75:0.54, b_WR75:1.06},\n  \"3f\": {a_tp:0.47, b_tp:0.69, a_qp:1.19, b_qp:0.62, a_TB:8.20, b_TB:0.53, a_W50:2.29, b_W50:0.99, a_W75:1.34, b_W75:0.98, a_WR50:0.84, b_WR50:1.01, a_WR75:0.57, b_WR75:1.02},\n  \"3h\": {a_tp:0.44, b_tp:0.71, a_qp:1.17, b_qp:0.64, a_TB:8.45, b_TB:0.51, a_W50:2.26, b_W50:1.01, a_W75:1.33, b_W75:0.99, a_WR50:0.82, b_WR50:1.03, a_WR75:0.56, b_WR75:1.04},\n  \"3i\": {a_tp:0.46, b_tp:0.70, a_qp:1.16, b_qp:0.63, a_TB:8.30, b_TB:0.52, a_W50:2.28, b_W50:1.00, a_W75:1.33, b_W75:0.99, a_WR50:0.83, b_WR50:1.02, a_WR75:0.56, b_WR75:1.03},\n  \"5a\": {a_tp:0.40, b_tp:0.75, a_qp:1.10, b_qp:0.68, a_TB:9.00, b_TB:0.45, a_W50:2.20, b_W50:1.05, a_W75:1.28, b_W75:1.03, a_WR50:0.76, b_WR50:1.08, a_WR75:0.52, b_WR75:1.09},\n  \"7\":  {a_tp:0.38, b_tp:0.76, a_qp:1.08, b_qp:0.69, a_TB:9.20, b_TB:0.44, a_W50:2.18, b_W50:1.06, a_W75:1.26, b_W75:1.04, a_WR50:0.74, b_WR50:1.09, a_WR75:0.50, b_WR75:1.10}\n};\nreturn table[inputs.sub_zone] || table[\"3a\"];",
