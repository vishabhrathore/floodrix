[
  {
    "id": "node_cc_slope",
    "type": "CUSTOM_CODE",
    "label": "Equivalent Stream Slope",
    "config": {
      "code": "const pts = typeof inputs.stream_profile === 'string' ? JSON.parse(inputs.stream_profile) : inputs.stream_profile;\nconst L   = inputs.stream_length;\nconst last = pts[pts.length - 1].rl;\nlet sum = 0;\nfor (let i = 1; i < pts.length; i++) {\n  const Li      = pts[i].chainage - pts[i-1].chainage;\n  const Di_prev = pts[i-1].rl - last;\n  const Di      = pts[i].rl    - last;\n  sum += Li * (Di_prev + Di);\n}\nreturn {\n  equiv_slope: sum / (L * L),\n  sum_li_di_prev_di: sum\n};",
      "use_worker": true,
      "output_variables": [
        "equiv_slope",
        "sum_li_di_prev_di"
      ]
    }
  },
