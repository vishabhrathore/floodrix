      "code": "const drh = inputs.drh_ordinates;\nconst Qb  = inputs.base_flow_total;\nconst pmf = drh.map(v => v + Qb);\nlet peak = 0, idx = 0;\npmf.forEach((v,i) => { if (v > peak) { peak = v; idx = i; } });\nreturn { pmf_ordinates: pmf, pmf_peak: peak, pmf_peak_hr: idx };",
      "use_worker": true,
