  {
    "id": "node_cc_weighted",
    "type": "CUSTOM_CODE",
    "label": "Weighted Mean Rainfall (Isohyetal)",
    "config": {
      "code": "const bands = typeof inputs.isohyet_bands === 'string' ? JSON.parse(inputs.isohyet_bands) : inputs.isohyet_bands;\nlet sumAP = 0, sumA = 0;\nfor (const b of bands) {\n  const mean = (b.iso_min_mm + b.iso_max_mm) / 2;\n  sumAP += b.area_sqkm * mean;\n  sumA  += b.area_sqkm;\n}\nconst mm = sumAP / sumA;\nreturn { weighted_rainfall_mm: mm, sps_point_cm: mm / 10 };",
      "use_worker": true,
      "output_variables": [
        "weighted_rainfall_mm",
        "sps_point_cm"
      ]
    }
  },
  {
    "id": "node_cc_arf",
    "type": "CUSTOM_CODE",
    "label": "Areal Reduction Factor (interpolated)",
    "config": {
      "code": "const tables = {\n  24: [[500,0.94],[1000,0.91],[1500,0.90],[2000,0.88],[3000,0.86],[4000,0.83],[5000,0.81]],\n  48: [[500,0.95],[1000,0.92],[1500,0.91],[2000,0.89],[3000,0.87],[4000,0.85],[5000,0.83]],\n  72: [[500,0.96],[1000,0.94],[1500,0.93],[2000,0.92],[3000,0.90],[4000,0.88],[5000,0.86]]\n};\nconst T = tables[inputs.storm_duration_hr] || tables[24];\nconst A = inputs.catchment_area;\nif (A <= T[0][0])   return { areal_reduction: T[0][1] };\nif (A >= T.at(-1)[0]) return { areal_reduction: T.at(-1)[1] };\nfor (let i = 1; i < T.length; i++) {\n  if (A <= T[i][0]) {\n    const f = (A - T[i-1][0]) / (T[i][0] - T[i-1][0]);\n    return { areal_reduction: T[i-1][1] + f * (T[i][1] - T[i-1][1]) };\n  }\n}\nreturn { areal_reduction: 1.0 };",
      "use_worker": true,
      "output_variables": [
        "areal_reduction"
      ]
    }
  },
